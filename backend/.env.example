# 复制此文件为 .env 并填入真实值

# 服务端口(前端 vite 代理固定指向 4000,改这里需同步改 frontend/vite.config.js）
BACKEND_PORT=4000

# 首次启动时用来生成第一个管理员账号(账号固定叫 xiangtang)的初始密码;
# 之后账号密码都存在数据库 users 表里了,改这个值对已有账号没有任何影响,
# 忘了密码要在「管理」页面给自己重置,或者直接删 backend/data.db 重新触发首次生成。
APP_PASSWORD=admin

# JWT 签名密钥(随便填一串长随机字符）
JWT_SECRET=change-me-to-a-long-random-string

# ---- Telegram 发布(社群管理用）----
# 从 @BotFather 创建 bot 后拿到的 token
TELEGRAM_BOT_TOKEN=
# 目标频道/群的 chat id,如 @your_channel 或 -1001234567890
TELEGRAM_CHAT_ID=

# ---- AI 文案生成(社媒管理 + 频道配文,可选）----
# 用哪个 AI:claude 或 grok;留空=自动(有 XAI_API_KEY 用 grok,否则用 ANTHROPIC_API_KEY)
AI_PROVIDER=
# Anthropic(Claude）API key
ANTHROPIC_API_KEY=
# Grok(xAI）API key 和模型,在 https://console.x.ai 申请
XAI_API_KEY=
GROK_MODEL=grok-3

# ---- 评论审核助手 + 经营数据看板(对接 hanimepro 管理后台)----
# 管理后台地址,一般不用改
HANIME_ADMIN_BASE_URL=https://sf-10-hanimepro-ht.zcxyprod.cc

# 推荐:填这三个,后端会自动登录换 token、2小时过期后自动重新登录,不用再手动复制
HANIME_ADMIN_USERNAME=
HANIME_ADMIN_PASSWORD=
# 谷歌验证器绑定时的那串密钥(不是 APP 里跳动的 6 位数字,是绑定时的固定密钥)
HANIME_ADMIN_TOTP_SECRET=

# 兜底:不想配自动登录的话,也可以像以前一样从浏览器 Network 里复制 x-admin-token
# 填这里,但 2 小时左右会过期,过期后评论审核/经营数据看板会报错,需要重新复制
HANIME_ADMIN_TOKEN=

# ---- X / Twitter 发布(社媒管理用）----
# 在 https://developer.x.com 创建 App,启用 Read and Write 权限后拿到这 4 个值
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
